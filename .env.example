# Copy to .env and adjust. All values are optional; defaults are shown.
# Relative paths are resolved against the directory you run the CLI from.

# --- LLM: any OpenAI-compatible endpoint (normally llama-server running Ornith) ---
LLAMA_BASE_URL=http://127.0.0.1:8081/v1
LLAMA_MODEL=ornith
# LLAMA_API_KEY=
LLAMA_TIMEOUT=600
LLAMA_TEMPERATURE=0.2
LLAMA_MAX_TOKENS=4096
# Grammar-constrained JSON output via response_format=json_schema (llama-server supports it)
LLAMA_JSON_SCHEMA=true
# Ornith/Qwen-style models: disable the <think> phase for structured analysis
LLAMA_DISABLE_THINKING=true

# --- Optional: let AudioBooks start llama-server for analysis and stop it before TTS ---
# (needed on 6 GB GPUs because Ornith and Qwen3-TTS do not fit in VRAM together)
LLM_AUTO_MANAGE=false
LLAMA_SERVER_EXE=llama-server
# LLAMA_MODEL_PATH=C:\path\to\Ornith-1.5-9B-MTP-IQ4_XS.gguf
# LLAMA_MMPROJ_PATH=C:\path\to\mmproj-Ornith-1.5-9B-BF16.gguf
LLAMA_SERVER_PORT=8081
LLAMA_CTX_SIZE=16384
LLAMA_GPU_LAYERS=99
# Extra flags appended verbatim, e.g. "-fa on -ctk q8_0 -ctv q8_0"
LLAMA_SERVER_EXTRA_ARGS=

# --- Vision for scanned PDF pages (experimental; needs llama-server with --mmproj) ---
VISION_ENABLED=false

# --- TTS ---
# qwen = Qwen3-TTS (needs torch + qwen-tts), fake = test tones (no GPU)
TTS_BACKEND=qwen
TTS_MODEL=Qwen/Qwen3-TTS-12Hz-0.6B-Base
TTS_CUSTOM_VOICE_MODEL=Qwen/Qwen3-TTS-12Hz-0.6B-CustomVoice
TTS_DEVICE=cuda:0
TTS_DTYPE=bfloat16
# auto = detect from text (Russian/English), or e.g. Russian, English, Chinese
TTS_LANGUAGE=auto
TTS_USE_INSTRUCT=false

# --- Text processing ---
CHUNK_MAX_CHARS=4000
CHUNK_CONTEXT_PARAGRAPHS=3
SEGMENT_MAX_CHARS=400

# --- Voices ---
VOICE_LIBRARY_DIR=voices
NARRATOR_VOICE=narrator_01
# Voice for dialogue whose speaker could not be determined (empty = narrator voice)
UNKNOWN_SPEAKER_VOICE=

# --- Storage ---
OUTPUT_DIR=output
DATA_DIR=data
MAX_UPLOAD_MB=200

# --- Audio / FFmpeg ---
# Leave empty to find ffmpeg on PATH (or the winget install location on Windows)
FFMPEG_PATH=
AUDIO_FORMAT=m4a
AUDIO_BITRATE=96k
AUDIO_SAMPLE_RATE=44100
AUDIO_LOUDNORM=true
PAUSE_SAME_PARAGRAPH_MS=150
PAUSE_SPEAKER_CHANGE_MS=350
PAUSE_PARAGRAPH_MS=600
PAUSE_CHAPTER_START_MS=800

LOG_LEVEL=INFO
